{
  "name": "commons-budget-contract",
  "version": "1.0.0",
  "description": "Commons Budget Contract",
  "main": "",
  "directories": {
    "test": "test"
  },
  "scripts": {
    "clean": "hardhat clean",
    "build": "hardhat compile",
    "test": "hardhat test",
    "test:CommonsBudget": "NODE_ENV=test hardhat test test/CommonsBudget.test.ts",
    "prettier": "prettier --write --config .prettierrc 'contracts/**/*.sol' 'test/**/*.ts' 'src/utils/**/*.ts' 'scripts/**/*.ts'",

    "bosagora:mainnet:deployIssued": "# ENV_NETWORK=mainnet hardhat run deploy/mainnet/scripts/deploy.ts --network mainnet",
    "bosagora:mainnet:deployCommons": "# ENV_NETWORK=mainnet hardhat run deploy/mainnet/scripts/deploy_commons.ts --network mainnet",
    "bosagora:mainnet:getOwner": "ENV_NETWORK=mainnet hardhat run deploy/mainnet/scripts/get_owner.ts --network mainnet",
    "bosagora:mainnet:setOwner": "# ENV_NETWORK=mainnet hardhat run deploy/mainnet/scripts/set_owner.ts --network mainnet",
    "bosagora:mainnet:getCommons": "ENV_NETWORK=mainnet hardhat run deploy/mainnet/scripts/get_commons.ts --network mainnet",
    "bosagora:mainnet:setCommons": "ENV_NETWORK=mainnet hardhat run deploy/mainnet/scripts/set_commons.ts --network mainnet",
    "bosagora:mainnet:checkBudget": "ENV_NETWORK=mainnet hardhat run deploy/mainnet/scripts/check_budget.ts --network mainnet",
    "standalone:mainnet:deployIssued": "ENV_NETWORK=mainnet.standalone hardhat run deploy/mainnet/scripts/deploy.ts --network standalone",
    "standalone:mainnet:deployCommons": "ENV_NETWORK=mainnet.standalone hardhat run deploy/mainnet/scripts/deploy_commons.ts --network standalone",
    "standalone:mainnet:getOwner": "ENV_NETWORK=mainnet.standalone hardhat run deploy/mainnet/scripts/get_owner.ts --network standalone",
    "standalone:mainnet:setOwner": "ENV_NETWORK=mainnet.standalone hardhat run deploy/mainnet/scripts/set_owner.ts --network standalone",
    "standalone:mainnet:getCommons": "ENV_NETWORK=mainnet.standalone hardhat run deploy/mainnet/scripts/get_commons.ts --network standalone",
    "standalone:mainnet:setCommons": "ENV_NETWORK=mainnet.standalone hardhat run deploy/mainnet/scripts/set_commons.ts --network standalone",
    "standalone:mainnet:checkBudget": "ENV_NETWORK=mainnet.standalone hardhat run deploy/mainnet/scripts/check_budget.ts --network standalone",

    "standalone:testnet:deployIssued": "ENV_NETWORK=testnet.standalone hardhat run deploy/testnet/scripts/deploy.ts --network standalone",
    "standalone:testnet:deployCommons": "ENV_NETWORK=testnet.standalone hardhat run deploy/testnet/scripts/deploy_commons.ts --network standalone",
    "standalone:testnet:getOwner": "ENV_NETWORK=testnet.standalone hardhat run deploy/testnet/scripts/get_owner.ts --network standalone",
    "standalone:testnet:setOwner": "ENV_NETWORK=testnet.standalone hardhat run deploy/testnet/scripts/set_owner.ts --network standalone",
    "standalone:testnet:getCommons": "ENV_NETWORK=testnet.standalone hardhat run deploy/testnet/scripts/get_commons.ts --network standalone",
    "standalone:testnet:setCommons": "ENV_NETWORK=testnet.standalone hardhat run deploy/testnet/scripts/set_commons.ts --network standalone",
    "standalone:testnet:checkBudget": "ENV_NETWORK=testnet.standalone hardhat run deploy/testnet/scripts/check_budget.ts --network standalone",
    "standalone:testnet:transfer": "ENV_NETWORK=testnet.standalone hardhat run deploy/testnet/scripts/transfer_budget.ts --network standalone"
  },
  "repository": {
    "type": "git+https://github.com/zeroone-boa/commons-budget-contract.git",
